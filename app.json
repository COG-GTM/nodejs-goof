{
  "name": "goof",
  "description": "A Snyk vulnerable Goof app on Heroku",
  "repository": "https://github.com/snyk/goof",
  "logo": "https://snyk.io/wp-content/uploads/title-card-avatar.png",
  "keywords": [
    "snyk",
    "goof",
    "heroku",
    "node",
    "security",
    "vulnerabilities"
  ],
  "image": "heroku/nodejs",
  "scripts": {},
  "env": {
    "MONGOLAB_URI": {
      "required": true
    },
    "ADMIN_USERNAME": {
      "description": "Admin login username seeded at startup",
      "value": "admin@snyk.io"
    },
    "ADMIN_PASSWORD": {
      "description": "Admin login password (random if omitted, printed to logs)",
      "required": false
    },
    "SESSION_SECRET": {
      "description": "Session signing secret",
      "generator": "secret"
    }
  },
  "formation": {
    "web": {
      "quantity": 1
    }
  },
  "addons": [
    "mongolab"
  ],
  "buildpacks": [
    {
      "url": "heroku/nodejs"
    }
  ]
}
