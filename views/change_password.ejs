<% layout( 'layout' ) -%>
<style>
strong {font-weight: bold}
.error {color: #b00020}
</style>
<h1 id="page-title"><%= title %></h1>

<div id="list">
  <form action="/change_password" method="post" accept-charset="utf-8">
    <div class="item-new">
      <% if( error ){ %>
      <center class="error"><%= error %></center>
      <% } %>
      <center>current password</center>
      <input class="input" type="password" name="currentPassword" />
      <br/>
      <center>new password</center>
      <input class="input" type="password" name="newPassword" />
      <center>
      <input type="submit">
      </center>
    </div>
  </form>
</div>
