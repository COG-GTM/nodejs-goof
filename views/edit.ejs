<% layout( 'layout' ) -%>

<h1 id="page-title"><%= title %></h1>
<div id="list">
  <form action="/create" method="post" accept-charset="utf-8">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <div class="item-new">
      <input class="input" type="text" name="content" />
    </div>
  </form>

<% todos.forEach( function ( todo ){ %>
  <% if( todo._id == current ){ %>
  <div class="item-new">
  <% }else{ %>
  <div class="item">
  <% } %>

    <% if( todo._id == current ){ %>
    <form class="update-form" action="/update/<%= todo._id %>" method="post" accept-charset="utf-8">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <input class="update-input" type="text" name="content" value="<%= todo.content %>" />
    </form>
    <% }else if( todo.owner === currentUser ){ %>
    <a class="update-link" href="/edit/<%= todo._id %>" title="Update this todo item"><%= todo.content %></a>
    <% }else{ %>
    <span class="update-link"><%= todo.content %></span>
    <% } %>

    <% if( todo.owner === currentUser ){ %>
    <form class="del-form" action="/destroy/<%= todo._id %>" method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <button class="<%= todo._id == current ? 'del-btn-edit' : 'del-btn' %>" type="submit" title="Delete this todo item">Delete</button>
    </form>
    <% } %>
  </div>
<% }); %>
</div>
