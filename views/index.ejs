<style>
strong {font-weight: bold}
</style>

<div class="patch-header">
  <img class="snyk-patch" src="/public/images/snyk_patch.jpeg" />
  <h1 id="page-title"><%= title %></h1>
</div>

<div id="list">
  <form action="/create" method="post" accept-charset="utf-8">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <div class="item-new">
      <input class="input" type="text" name="content" />
    </div>
  </form>

<% todos.forEach( function ( todo ){ %>
  <div class="item">
    <a class="update-link" href="/edit/<%= todo._id %>" title="Update this todo item"><%- marked(String(todo.content)) %></a>
    <form class="del-form" action="/destroy/<%= todo._id %>" method="post" accept-charset="utf-8">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <button class="del-btn" type="submit" title="Delete this todo item">Delete</button>
    </form>
  </div>
<% }); %>
</div>
