    "ejs": "^3.1.10",
    "ejs-locals": "1.0.2",
    "errorhandler": "^1.5.1",
    "express": "^4.21.2",
    "express-fileupload": "^1.5.2",
    "express-session": "^1.18.2",
    "file-type": "^8.1.0",
    "hbs": "^4.3.1",
    "humanize-ms": "1.0.1",
    "jquery": "^3.7.1",
    "lodash": "^4.18.1",
    "marked": "0.3.12",
    "method-override": "latest",
    "moment": "^2.31.0",
    "mongodb": "^3.7.4",
    "mongoose": "^6.13.11",
    "morgan": "^1.12.1",
    "ms": "^2.1.3",
