    "ejs": "^3.1.10",
    "ejs-locals": "^1.0.2",
    "errorhandler": "^1.5.1",
    "express": "^4.21.0",
    "express-fileupload": "^1.5.1",
    "express-session": "^1.18.0",
    "file-type": "^8.1.0",
    "hbs": "^4.2.0",
    "helmet": "^7.1.0",
    "humanize-ms": "^1.2.1",
    "jquery": "^3.7.1",
    "lodash": "^4.17.21",
    "marked": "^12.0.2",
    "method-override": "^3.0.0",
    "moment": "^2.30.1",
