# Copy to .env (or export in your shell) before starting the app.

# express-session signing secret. Required in production; a random per-process
# value is generated for development when unset.
SESSION_SECRET=

# Application token. Required in production; randomly generated in development when unset.
APP_TOKEN=

# Password for the seeded admin@snyk.io user. Admin seeding is skipped when unset.
ADMIN_PASSWORD=

# Optional: serve HTTPS directly instead of plain HTTP.
# TLS_KEY=/path/to/privkey.pem
# TLS_CERT=/path/to/fullchain.pem

# Optional: MongoDB connection string (defaults to a local instance).
# MONGODB_URI=mongodb://localhost/express-todo
