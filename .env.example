# Copy to .env and replace every value. Never commit .env.
# The app connects as MYSQL_USER, a non-root account the mysql image grants
# access to MYSQL_DATABASE only. MYSQL_ROOT_PASSWORD is used by the container.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=acme
MYSQL_USER=goof
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too
# "development" enables TypeORM schema synchronize + query logging.
NODE_ENV=development
