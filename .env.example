# Environment configuration for the Flask Goof app
# Set DOCKER=1 when running under docker-compose (uses goof-mongo / goof-mysql hosts)
DOCKER=0
# MongoDB connection (defaults to mongodb://localhost/express-todo)
MONGODB_URI=mongodb://localhost/express-todo
MONGOLAB_URI=
# MySQL connection is built from host root:root@<host>:3306/acme
PORT=3001
