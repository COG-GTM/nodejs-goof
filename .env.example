# Express session secret
SESSION_SECRET=your-session-secret-here

# Application secret token
APP_SECRET_TOKEN=your-app-secret-token-here

# Admin user password (seeded into MongoDB on first run)
ADMIN_PASSWORD=your-admin-password-here

# MySQL / TypeORM connection settings
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=your-mysql-password-here
MYSQL_DATABASE=acme

# Chat feature credentials
CHAT_USER_PASSWORD=your-chat-user-password-here
CHAT_ADMIN_PASSWORD=your-chat-admin-password-here
