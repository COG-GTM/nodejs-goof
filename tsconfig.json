{
  "compilerOptions": {
    "target": "ES2019",
    "module": "commonjs",
    "moduleResolution": "node",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true
  },
  "include": ["*.ts", "entity/**/*.ts", "routes/**/*.ts", "service/**/*.ts", "types/**/*.d.ts"],
  "exclude": ["node_modules", "dist", "public", "tests"]
}
